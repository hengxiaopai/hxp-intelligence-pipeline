{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hengxiaopai.com/schemas/connector-request.schema.json",
  "title": "HXP Connector Draft Request",
  "description": "由已批准发布条目和未过期授权生成的单次连接器请求。当前只允许离线Simulator。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "authorization_id",
    "connector_id",
    "connector_mode",
    "platform",
    "account_ref",
    "entry_id",
    "package_id",
    "idempotency_key",
    "content_hash",
    "asset_hashes",
    "action",
    "requested_at",
    "status",
    "real_write_allowed",
    "credential_reference"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "request_id": {"type": "string", "pattern": "^connector-request-[a-f0-9]{32,64}$"},
    "authorization_id": {"type": "string", "pattern": "^connector-auth-[a-f0-9]{32,64}$"},
    "connector_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"},
    "connector_mode": {"type": "string", "enum": ["simulator", "real", "manual_handoff"]},
    "platform": {"type": "string", "enum": ["wechat", "xiaohongshu", "douyin", "x", "website"]},
    "account_ref": {"type": "string", "minLength": 3, "maxLength": 160},
    "entry_id": {"type": "string", "pattern": "^publication-entry-[0-9]{8}-(wechat|xiaohongshu|douyin|x|website)$"},
    "package_id": {"type": "string", "pattern": "^content-package-[0-9]{8}-(wechat|xiaohongshu|douyin|x|website)$"},
    "idempotency_key": {"type": "string", "pattern": "^pub-[a-f0-9]{32,64}$"},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "asset_hashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "action": {"type": "string", "const": "draft_only"},
    "requested_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["ready", "simulated", "blocked", "failed"]},
    "real_write_allowed": {"type": "boolean", "const": false},
    "credential_reference": {
      "type": ["string", "null"],
      "pattern": "^(env:[A-Z][A-Z0-9_]{2,100}|secret:[a-zA-Z0-9/_-]{3,160})$"
    }
  }
}
