{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hengxiaopai.com/schemas/connector-authorization.schema.json",
  "title": "HXP Connector Authorization",
  "description": "把一次连接器授权绑定到平台、账号引用、发布条目、内容哈希、图片哈希、动作和到期时间。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization_id",
    "connector_id",
    "platform",
    "account_ref",
    "entry_id",
    "idempotency_key",
    "content_hash",
    "asset_hashes",
    "action",
    "issued_at",
    "expires_at",
    "issued_by",
    "status",
    "real_write_allowed",
    "credential_reference"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "authorization_id": {"type": "string", "pattern": "^connector-auth-[a-f0-9]{32,64}$"},
    "connector_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"},
    "platform": {"type": "string", "enum": ["wechat", "xiaohongshu", "douyin", "x", "website"]},
    "account_ref": {"type": "string", "minLength": 3, "maxLength": 160},
    "entry_id": {"type": "string", "pattern": "^publication-entry-[0-9]{8}-(wechat|xiaohongshu|douyin|x|website)$"},
    "idempotency_key": {"type": "string", "pattern": "^pub-[a-f0-9]{32,64}$"},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "asset_hashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "action": {"type": "string", "enum": ["draft_only", "manual_publish", "connector_publish"]},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "issued_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "identifier"],
      "properties": {
        "type": {"type": "string", "const": "human"},
        "identifier": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    },
    "status": {"type": "string", "enum": ["issued", "consumed", "expired", "revoked"]},
    "real_write_allowed": {"type": "boolean", "const": false},
    "credential_reference": {
      "type": ["string", "null"],
      "description": "仅允许秘密存储引用或环境变量名，不得保存凭据值。",
      "pattern": "^(env:[A-Z][A-Z0-9_]{2,100}|secret:[a-zA-Z0-9/_-]{3,160})$"
    }
  }
}
