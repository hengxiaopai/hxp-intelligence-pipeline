{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hengxiaopai.com/schemas/mobile-handoff.schema.json",
  "title": "HXP Mobile Handoff Manifest",
  "description": "将已验证的小红书、抖音和知乎交接内容整理为可传输到手机的离线目录，不执行平台写入。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mobile_handoff_id",
    "handoff_id",
    "date",
    "generated_at",
    "external_write_performed",
    "packages",
    "summary"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "mobile_handoff_id": {"type": "string", "pattern": "^mobile-handoff-[0-9]{8}$"},
    "handoff_id": {"type": "string", "pattern": "^handoff-[0-9]{8}$"},
    "date": {"type": "string", "format": "date"},
    "generated_at": {"type": "string", "format": "date-time"},
    "external_write_performed": {"type": "boolean", "const": false},
    "packages": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/package"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "ready", "failed", "assets"],
      "properties": {
        "total": {"type": "integer", "const": 3},
        "ready": {"type": "integer", "minimum": 0, "maximum": 3},
        "failed": {"type": "integer", "minimum": 0, "maximum": 3},
        "assets": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_size"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 500},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "byte_size": {"type": "integer", "minimum": 1}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "path", "sha256", "byte_size"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "path": {"type": "string", "minLength": 1, "maxLength": 500},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "byte_size": {"type": "integer", "minimum": 1}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "display_name",
        "status",
        "content_hash",
        "asset_hashes",
        "directory",
        "instructions",
        "content_text",
        "content_markdown",
        "assets",
        "errors"
      ],
      "properties": {
        "platform": {"type": "string", "enum": ["xiaohongshu", "douyin", "zhihu"]},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 80},
        "status": {"type": "string", "enum": ["ready", "failed"]},
        "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "asset_hashes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "directory": {"type": "string", "minLength": 1, "maxLength": 300},
        "instructions": {"$ref": "#/$defs/file"},
        "content_text": {"$ref": "#/$defs/file"},
        "content_markdown": {"$ref": "#/$defs/file"},
        "assets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/asset"}},
        "errors": {"type": "array", "items": {"type": "string", "maxLength": 300}}
      }
    }
  }
}
