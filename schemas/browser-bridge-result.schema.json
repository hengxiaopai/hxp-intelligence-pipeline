{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hengxiaopai.com/schemas/browser-bridge-result.schema.json",
  "title": "HXP Local Browser Bridge Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "bridge_request_id",
    "request_fingerprint",
    "bridge_id",
    "provider",
    "operation",
    "completed_at",
    "mode",
    "status",
    "external_write_performed",
    "structured_result_used",
    "cli_exit_code_used_as_authority",
    "platform_results",
    "errors"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "result_id": {"type": "string", "pattern": "^bridge-result-[a-f0-9]{32,64}$"},
    "bridge_request_id": {"type": "string", "pattern": "^bridge-request-[a-f0-9]{32,64}$"},
    "request_fingerprint": {"type": "string", "pattern": "^bridge-[a-f0-9]{32,64}$"},
    "bridge_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"},
    "provider": {"type": "string", "enum": ["wechatsync"]},
    "operation": {"type": "string", "enum": ["list_platforms", "check_auth", "preview_draft", "create_draft"]},
    "completed_at": {"type": "string", "format": "date-time"},
    "mode": {"type": "string", "enum": ["fixture", "offline_parse", "read_only_live", "draft_live"]},
    "status": {"type": "string", "enum": ["success", "partial_success", "failed", "blocked"]},
    "external_write_performed": {"type": "boolean", "const": false},
    "structured_result_used": {"type": "boolean"},
    "cli_exit_code_used_as_authority": {"type": "boolean", "const": false},
    "platform_results": {
      "type": "array",
      "items": {"$ref": "#/$defs/platformResult"}
    },
    "errors": {
      "type": "array",
      "items": {"$ref": "#/$defs/error"}
    }
  },
  "$defs": {
    "platformResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "outcome",
        "draft_only",
        "platform_post_id",
        "sanitized_url",
        "account_ref",
        "error_code",
        "message"
      ],
      "properties": {
        "platform": {"type": "string", "enum": ["zhihu", "juejin", "csdn"]},
        "outcome": {"type": "string", "enum": ["authenticated", "unauthenticated", "draft_created", "failed", "review_required", "blocked", "unknown"]},
        "draft_only": {"type": "boolean", "const": true},
        "platform_post_id": {"type": ["string", "null"], "maxLength": 200},
        "sanitized_url": {"type": ["string", "null"], "format": "uri"},
        "account_ref": {"type": ["string", "null"], "maxLength": 160},
        "error_code": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{2,80}$"},
        "message": {"type": ["string", "null"], "maxLength": 500}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "classification", "message", "recoverable"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,80}$"},
        "classification": {"type": "string", "enum": ["configuration", "authentication", "identity", "risk_control", "transport", "upstream", "unknown"]},
        "message": {"type": "string", "minLength": 3, "maxLength": 500},
        "recoverable": {"type": "boolean"}
      }
    }
  }
}
