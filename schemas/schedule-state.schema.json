{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hengxiaopai.com/schemas/schedule-state.schema.json",
  "title": "HXP Source Schedule State",
  "description": "记录各来源最近尝试、成功、失败和内容水位，用于确定性增量调度。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "sources"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "updated_at": {"type": "string", "format": "date-time"},
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourceState"}
    }
  },
  "$defs": {
    "sourceState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_id",
        "last_attempt_at",
        "last_success_at",
        "last_content_hash",
        "last_status",
        "consecutive_failures",
        "last_failure_fingerprint"
      ],
      "properties": {
        "registry_id": {
          "type": "string",
          "pattern": "^registry-[a-z0-9][a-z0-9-]{4,100}$"
        },
        "last_attempt_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "last_success_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "last_content_hash": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "last_status": {
          "type": "string",
          "enum": ["never", "success", "failure", "skipped"]
        },
        "consecutive_failures": {
          "type": "integer",
          "minimum": 0
        },
        "last_failure_fingerprint": {
          "type": ["string", "null"],
          "pattern": "^failure-[a-f0-9]{16,64}$"
        }
      }
    }
  }
}
