{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hengxiaopai.com/schemas/publication-result.schema.json",
  "title": "HXP Publication Result",
  "description": "记录草稿预览、人工发布确认或未来连接器写入的结果。当前阶段只允许 dry_run。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_batch_id",
    "plan_id",
    "approval_id",
    "executed_at",
    "execution_mode",
    "external_write_performed",
    "results",
    "summary"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "result_batch_id": {"type": "string", "pattern": "^publication-result-[0-9]{8}$"},
    "plan_id": {"type": "string", "pattern": "^publication-plan-[0-9]{8}$"},
    "approval_id": {"type": ["string", "null"], "pattern": "^publication-approval-[0-9]{8}-[a-z0-9-]{3,40}$"},
    "executed_at": {"type": "string", "format": "date-time"},
    "execution_mode": {"type": "string", "const": "dry_run"},
    "external_write_performed": {"type": "boolean", "const": false},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/result"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "previewed", "blocked", "failed"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "previewed": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "platform",
        "idempotency_key",
        "status",
        "preview_path",
        "external_id",
        "external_url",
        "attempt",
        "error_type",
        "error_message",
        "content_hash",
        "asset_hashes"
      ],
      "properties": {
        "entry_id": {
          "type": "string",
          "pattern": "^publication-entry-[0-9]{8}-(wechat|xiaohongshu|douyin|x|website|zhihu)$"
        },
        "platform": {"type": "string", "enum": ["wechat", "xiaohongshu", "douyin", "x", "website", "zhihu"]},
        "idempotency_key": {"type": "string", "pattern": "^pub-[a-f0-9]{32,64}$"},
        "status": {"type": "string", "enum": ["previewed", "blocked", "failed"]},
        "preview_path": {"type": ["string", "null"], "maxLength": 500},
        "external_id": {"type": "null"},
        "external_url": {"type": "null"},
        "attempt": {"type": "integer", "const": 1},
        "error_type": {"type": ["string", "null"], "maxLength": 120},
        "error_message": {"type": ["string", "null"], "maxLength": 600},
        "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "asset_hashes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
