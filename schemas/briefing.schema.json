{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hengxiaopai.com/schemas/briefing.schema.json",
  "title": "HXP Daily Intelligence Briefing",
  "description": "珩小派多元情报简报的结构化数据契约。允许在高质量信号不足时少于目标数量，但必须记录原因，禁止为凑数引入低价值信息。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "briefing_id",
    "date",
    "timezone",
    "generated_at",
    "title",
    "editorial_policy",
    "new_items",
    "continuation_items",
    "content_opportunities",
    "risk_reminder",
    "weekly_threads",
    "source_index"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "briefing_id": {
      "type": "string",
      "pattern": "^hxp-briefing-[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "timezone": {
      "type": "string",
      "default": "Asia/Shanghai"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "language": {
      "type": "string",
      "const": "zh-CN",
      "default": "zh-CN"
    },
    "title": {
      "type": "string",
      "minLength": 4,
      "maxLength": 80
    },
    "editorial_policy": {
      "$ref": "#/$defs/editorialPolicy"
    },
    "new_items": {
      "type": "array",
      "description": "今日新增事实。目标为 5–8 条；若不足，必须在 editorial_policy.shortfall_reason 中说明。",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/newItem"
      }
    },
    "continuation_items": {
      "type": "array",
      "description": "过去已出现、但今天存在实质新增变化的连续热点。",
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/continuationItem"
      }
    },
    "content_opportunities": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/contentOpportunity"
      }
    },
    "product_opportunity": {
      "description": "产品机会必须通过产品化门槛；不满足时允许为 null。",
      "oneOf": [
        {
          "$ref": "#/$defs/productOpportunity"
        },
        {
          "type": "null"
        }
      ]
    },
    "risk_reminder": {
      "$ref": "#/$defs/riskReminder"
    },
    "weekly_threads": {
      "$ref": "#/$defs/weeklyThreads"
    },
    "rejected_candidates": {
      "type": "array",
      "description": "内部留档：记录未入选热点及淘汰原因，不用于公开海报。",
      "items": {
        "$ref": "#/$defs/rejectedCandidate"
      }
    },
    "source_index": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^src-[a-z0-9][a-z0-9-]{5,80}$"
      }
    }
  },
  "$defs": {
    "editorialPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_min_items",
        "target_max_items",
        "actual_new_item_count",
        "new_or_new_angle_ratio",
        "dedup_windows_days",
        "source_requirements_met"
      ],
      "properties": {
        "target_min_items": {
          "type": "integer",
          "const": 5
        },
        "target_max_items": {
          "type": "integer",
          "const": 8
        },
        "actual_new_item_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "shortfall_reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "new_or_new_angle_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dedup_windows_days": {
          "type": "array",
          "prefixItems": [
            {
              "const": 3
            },
            {
              "const": 7
            },
            {
              "const": 30
            }
          ],
          "items": false
        },
        "source_requirements_met": {
          "type": "boolean"
        },
        "market_session": {
          "type": "string",
          "enum": [
            "pre_market",
            "in_session",
            "post_market",
            "weekend_or_holiday",
            "not_applicable"
          ]
        }
      }
    },
    "baseItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "event_fingerprint",
        "status",
        "title",
        "summary",
        "primary_category",
        "information_types",
        "confidence",
        "importance_score",
        "novelty_score",
        "why_it_matters",
        "follow_up",
        "conversion_directions",
        "audiences",
        "source_ids",
        "primary_source_id",
        "first_seen",
        "last_updated",
        "selected_reason",
        "risk_flags",
        "visual_brief"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "pattern": "^item-[0-9]{8}-[0-9]{2}$"
        },
        "event_fingerprint": {
          "type": "string",
          "pattern": "^evt-[a-f0-9]{16,64}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "new",
            "continuation"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32
        },
        "subtitle": {
          "type": "string",
          "maxLength": 60
        },
        "summary": {
          "type": "string",
          "minLength": 20,
          "maxLength": 220
        },
        "primary_category": {
          "type": "string",
          "enum": [
            "ai_technology",
            "developer_tools",
            "open_source",
            "ai_hardware",
            "a_share_industry",
            "product_trend",
            "social_content",
            "design_brand",
            "policy_regulation",
            "business_strategy",
            "consumer_ai",
            "career_skills",
            "risk_counter_signal"
          ]
        },
        "information_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "official_release",
              "paper",
              "rumor",
              "research_report",
              "financial_report",
              "earnings_guidance",
              "social_trend",
              "github_project",
              "github_update",
              "policy",
              "funding",
              "company_announcement",
              "product_launch",
              "security_incident",
              "market_flow",
              "design_reference"
            ]
          }
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "importance_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "novelty_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "why_it_matters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 4,
            "maxLength": 90
          }
        },
        "follow_up": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 4,
            "maxLength": 90
          }
        },
        "conversion_directions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "wechat_article",
              "douyin_carousel",
              "short_video",
              "poster",
              "product_prototype",
              "deep_report",
              "industry_observation",
              "design_inspiration",
              "database_update",
              "website_feature"
            ]
          }
        },
        "audiences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "general_public",
              "developers",
              "creators",
              "investors",
              "enterprise_users",
              "designers",
              "founders",
              "students"
            ]
          }
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^src-[a-z0-9][a-z0-9-]{5,80}$"
          }
        },
        "primary_source_id": {
          "type": "string",
          "pattern": "^src-[a-z0-9][a-z0-9-]{5,80}$"
        },
        "first_seen": {
          "type": "string",
          "format": "date-time"
        },
        "last_updated": {
          "type": "string",
          "format": "date-time"
        },
        "selected_reason": {
          "type": "string",
          "minLength": 8,
          "maxLength": 240
        },
        "risk_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "unconfirmed",
              "policy_in_discussion",
              "financial_not_audited",
              "market_data_time_sensitive",
              "investment_advice_risk",
              "copyright_risk",
              "platform_review_risk",
              "security_sensitive",
              "brand_affiliation_risk",
              "none"
            ]
          }
        },
        "visual_brief": {
          "$ref": "#/$defs/visualBrief"
        },
        "continuation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "previous_item_ids",
            "new_delta",
            "background_repeated"
          ],
          "properties": {
            "previous_item_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^item-[0-9]{8}-[0-9]{2}$"
              }
            },
            "new_delta": {
              "type": "string",
              "minLength": 12,
              "maxLength": 240
            },
            "background_repeated": {
              "type": "boolean",
              "const": false
            }
          }
        }
      }
    },
    "newItem": {
      "allOf": [
        {
          "$ref": "#/$defs/baseItem"
        },
        {
          "properties": {
            "status": {
              "const": "new"
            }
          },
          "not": {
            "required": [
              "continuation"
            ]
          }
        }
      ]
    },
    "continuationItem": {
      "allOf": [
        {
          "$ref": "#/$defs/baseItem"
        },
        {
          "required": [
            "continuation"
          ],
          "properties": {
            "status": {
              "const": "continuation"
            },
            "continuation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "previous_item_ids",
                "new_delta",
                "background_repeated"
              ],
              "properties": {
                "previous_item_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^item-[0-9]{8}-[0-9]{2}$"
                  }
                },
                "new_delta": {
                  "type": "string",
                  "minLength": 12,
                  "maxLength": 240
                },
                "background_repeated": {
                  "type": "boolean",
                  "const": false
                }
              }
            }
          }
        }
      ]
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "score",
        "rationale",
        "evidence_count"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "high",
            "medium_high",
            "observe",
            "low"
          ]
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "rationale": {
          "type": "string",
          "minLength": 8,
          "maxLength": 240
        },
        "evidence_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "visualBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concept",
        "visual_type",
        "must_not_fabricate"
      ],
      "properties": {
        "concept": {
          "type": "string",
          "minLength": 8,
          "maxLength": 300
        },
        "visual_type": {
          "type": "string",
          "enum": [
            "ai_generated_concept",
            "official_screenshot",
            "self_made_infographic",
            "data_chart",
            "mixed"
          ]
        },
        "must_not_fabricate": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          }
        }
      }
    },
    "contentOpportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opportunity_id",
        "wechat_title",
        "douyin_title",
        "angle",
        "visual_direction",
        "related_item_ids"
      ],
      "properties": {
        "opportunity_id": {
          "type": "string",
          "pattern": "^content-[0-9]{8}-[0-9]{2}$"
        },
        "wechat_title": {
          "type": "string",
          "minLength": 8,
          "maxLength": 50
        },
        "douyin_title": {
          "type": "string",
          "minLength": 6,
          "maxLength": 36
        },
        "angle": {
          "type": "string",
          "minLength": 12,
          "maxLength": 260
        },
        "visual_direction": {
          "type": "string",
          "minLength": 8,
          "maxLength": 240
        },
        "related_item_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^item-[0-9]{8}-[0-9]{2}$"
          }
        }
      }
    },
    "productOpportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "verdict",
        "score",
        "target_users",
        "pain_point",
        "mvp",
        "seven_day_feasibility",
        "payment_signal",
        "competition_level",
        "hxp_advantage",
        "evidence_item_ids"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 4,
          "maxLength": 50
        },
        "verdict": {
          "type": "string",
          "enum": [
            "build",
            "observe",
            "reject"
          ]
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "target_users": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "maxLength": 60
          }
        },
        "pain_point": {
          "type": "string",
          "minLength": 12,
          "maxLength": 260
        },
        "mvp": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "seven_day_feasibility": {
          "type": "boolean"
        },
        "payment_signal": {
          "type": "string",
          "enum": [
            "strong",
            "medium",
            "weak",
            "unknown"
          ]
        },
        "competition_level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "hxp_advantage": {
          "type": "string",
          "minLength": 8,
          "maxLength": 220
        },
        "evidence_item_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^item-[0-9]{8}-[0-9]{2}$"
          }
        }
      }
    },
    "riskReminder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "risk_type",
        "description",
        "safe_wording"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 4,
          "maxLength": 50
        },
        "risk_type": {
          "type": "string",
          "enum": [
            "unconfirmed_claim",
            "repeated_hype",
            "overheated_concept",
            "platform_review",
            "regulatory_compliance",
            "financial_expression",
            "copyright",
            "security",
            "visual_misrepresentation"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 12,
          "maxLength": 320
        },
        "safe_wording": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        }
      }
    },
    "weeklyThreads": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keywords",
        "strongest_trend",
        "deep_dive_topic",
        "productization_opportunity"
      ],
      "properties": {
        "keywords": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 30
          }
        },
        "strongest_trend": {
          "type": "string",
          "minLength": 12,
          "maxLength": 300
        },
        "deep_dive_topic": {
          "type": "string",
          "minLength": 8,
          "maxLength": 100
        },
        "productization_opportunity": {
          "type": "string",
          "minLength": 8,
          "maxLength": 180
        }
      }
    },
    "rejectedCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "title",
        "rejection_reason"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^candidate-[0-9]{8}-[0-9]{2,3}$"
        },
        "title": {
          "type": "string",
          "maxLength": 80
        },
        "rejection_reason": {
          "type": "string",
          "enum": [
            "duplicate_event",
            "duplicate_viewpoint",
            "no_new_delta",
            "low_confidence",
            "low_impact",
            "pure_marketing",
            "funding_only",
            "insufficient_sources",
            "outside_window",
            "quota_balance"
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 240
        }
      }
    }
  }
}
