{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hengxiaopai.com/schemas/connector-result.schema.json",
  "title": "HXP Connector Execution Result",
  "description": "连接器执行结果。Phase 5.2 当前只允许Simulator，外部写入必须为false。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "request_id",
    "authorization_id",
    "connector_id",
    "connector_mode",
    "platform",
    "account_ref",
    "entry_id",
    "idempotency_key",
    "content_hash",
    "asset_hashes",
    "executed_at",
    "status",
    "external_write_performed",
    "external_id",
    "external_url",
    "simulated_draft_id",
    "response_summary",
    "error_type",
    "error_message"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "result_id": {"type": "string", "pattern": "^connector-result-[a-f0-9]{32,64}$"},
    "request_id": {"type": "string", "pattern": "^connector-request-[a-f0-9]{32,64}$"},
    "authorization_id": {"type": "string", "pattern": "^connector-auth-[a-f0-9]{32,64}$"},
    "connector_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"},
    "connector_mode": {"type": "string", "const": "simulator"},
    "platform": {"type": "string", "enum": ["wechat", "xiaohongshu", "douyin", "x", "website"]},
    "account_ref": {"type": "string", "minLength": 3, "maxLength": 160},
    "entry_id": {"type": "string", "pattern": "^publication-entry-[0-9]{8}-(wechat|xiaohongshu|douyin|x|website)$"},
    "idempotency_key": {"type": "string", "pattern": "^pub-[a-f0-9]{32,64}$"},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "asset_hashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "executed_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["simulated", "idempotent_replay", "blocked", "failed"]},
    "external_write_performed": {"type": "boolean", "const": false},
    "external_id": {"type": "null"},
    "external_url": {"type": "null"},
    "simulated_draft_id": {"type": ["string", "null"], "pattern": "^sim-draft-[a-f0-9]{20,64}$"},
    "response_summary": {"type": "string", "minLength": 1, "maxLength": 600},
    "error_type": {"type": ["string", "null"], "maxLength": 120},
    "error_message": {"type": ["string", "null"], "maxLength": 600}
  }
}
