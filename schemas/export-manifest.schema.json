{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hengxiaopai.com/schemas/export-manifest.schema.json",
  "title": "HXP Multi-platform Export Manifest",
  "description": "记录审核通过的内容和主视觉在各平台比例下的模板导出结果。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "export_manifest_id",
    "visual_manifest_id",
    "review_batch_id",
    "date",
    "generated_at",
    "template_version",
    "exports",
    "summary"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "export_manifest_id": {
      "type": "string",
      "pattern": "^export-manifest-[0-9]{8}$"
    },
    "visual_manifest_id": {
      "type": "string",
      "pattern": "^visual-manifest-[0-9]{8}$"
    },
    "review_batch_id": {
      "type": "string",
      "pattern": "^visual-review-[0-9]{8}-[a-z0-9-]{3,40}$"
    },
    "date": {"type": "string", "format": "date"},
    "generated_at": {"type": "string", "format": "date-time"},
    "template_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "exports": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/export"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "preset_counts"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "preset_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_size"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 500},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "byte_size": {"type": "integer", "minimum": 1}
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "export_id",
        "job_id",
        "item_id",
        "preset",
        "width",
        "height",
        "ratio",
        "platforms",
        "source_asset_sha256",
        "review_decision",
        "svg",
        "png",
        "text_overflow",
        "crop_safe",
        "status",
        "errors"
      ],
      "properties": {
        "export_id": {
          "type": "string",
          "pattern": "^export-[0-9]{8}-[0-9]{2}-[a-z0-9-]{3,40}$"
        },
        "job_id": {
          "type": "string",
          "pattern": "^visual-job-[0-9]{8}-[0-9]{2}$"
        },
        "item_id": {
          "type": ["string", "null"],
          "pattern": "^item-[0-9]{8}-[0-9]{2}$"
        },
        "preset": {
          "type": "string",
          "enum": [
            "vertical_9x16",
            "portrait_3x4",
            "landscape_16x9",
            "wechat_cover_235x1"
          ]
        },
        "width": {"type": "integer", "minimum": 1000, "maximum": 8192},
        "height": {"type": "integer", "minimum": 500, "maximum": 8192},
        "ratio": {"type": "string", "enum": ["9:16", "3:4", "16:9", "2.35:1"]},
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["douyin", "wechat_channels", "xiaohongshu", "x", "youtube", "website", "wechat_article"]
          }
        },
        "source_asset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "review_decision": {"type": "string", "const": "approved"},
        "svg": {"$ref": "#/$defs/file"},
        "png": {"$ref": "#/$defs/file"},
        "text_overflow": {"type": "boolean"},
        "crop_safe": {"type": "boolean"},
        "status": {"type": "string", "enum": ["passed", "failed"]},
        "errors": {
          "type": "array",
          "items": {"type": "string", "maxLength": 300}
        }
      }
    }
  }
}
