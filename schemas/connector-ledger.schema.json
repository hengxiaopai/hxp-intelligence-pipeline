{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hengxiaopai.com/schemas/connector-ledger.schema.json",
  "title": "HXP Connector Idempotency Ledger",
  "description": "离线Simulator与未来真实草稿连接器共用的幂等账本结构。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "entries"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "updated_at": {"type": "string", "format": "date-time"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "idempotency_key",
          "request_id",
          "result_id",
          "connector_id",
          "account_ref",
          "content_hash",
          "asset_hashes",
          "simulated_draft_id",
          "first_executed_at"
        ],
        "properties": {
          "idempotency_key": {"type": "string", "pattern": "^pub-[a-f0-9]{32,64}$"},
          "request_id": {"type": "string", "pattern": "^connector-request-[a-f0-9]{32,64}$"},
          "result_id": {"type": "string", "pattern": "^connector-result-[a-f0-9]{32,64}$"},
          "connector_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"},
          "account_ref": {"type": "string", "minLength": 3, "maxLength": 160},
          "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "asset_hashes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          },
          "simulated_draft_id": {"type": "string", "pattern": "^sim-draft-[a-f0-9]{20,64}$"},
          "first_executed_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
